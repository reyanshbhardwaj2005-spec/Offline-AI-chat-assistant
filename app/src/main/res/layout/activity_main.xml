<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ================= MAIN CONTENT ================= -->
    <FrameLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F4EE">

        <!-- ===== Model picker screen ===== -->
        <LinearLayout
            android:id="@+id/pickerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="Choose a model"
                android:textColor="#1F1E1D"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Runs fully offline on this phone."
                android:textColor="#73726C" />

            <EditText
                android:id="@+id/searchBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Search models"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#1F1E1D"
                android:textColorHint="#9A9890" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chat format:"
                    android:textColor="#1F1E1D" />

                <Spinner
                    android:id="@+id/templateSpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <ListView
                android:id="@+id/modelList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textColor="#73726C"
                android:textIsSelectable="true"
                android:visibility="gone" />

            <Button
                android:id="@+id/importBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Import model from storage (.gguf)" />
        </LinearLayout>

        <!-- ===== Chat screen ===== -->
        <LinearLayout
            android:id="@+id/chatLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F5F4EE"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Top bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <Button
                    android:id="@+id/menuBtn"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="0dp"
                    android:text="☰"
                    android:textColor="#1F1E1D"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <!-- Set from code once a chat has a title; empty on a fresh chat -->
                    <TextView
                        android:id="@+id/chatTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#1F1E1D"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/newChatTopBtn"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textColor="#1F1E1D"
                    android:textSize="26sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#73726C"
                android:textSize="12sp" />

            <!-- Messages + empty-state greeting -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/chatList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="8dp" />

                <!-- Show when the chat has no messages, hide otherwise -->
                <LinearLayout
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✻"
                        android:textColor="#D97757"
                        android:textSize="56sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:text="What shall we think through?"
                        android:textColor="#1F1E1D"
                        android:textSize="26sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Input card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:background="@drawable/bg_input_card"
                android:orientation="vertical"
                android:padding="12dp">

                <EditText
                    android:id="@+id/input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Message"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4"
                    android:minHeight="44dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="#1F1E1D"
                    android:textColorHint="#8A8880"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Optional: attach button (no code needed if unused) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/attachBtn"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:backgroundTint="@null"
                        android:background="@drawable/bg_pill"
                        android:minWidth="40dp"
                        android:minHeight="40dp"
                        android:padding="0dp"
                        android:text="+"
                        android:textColor="#1F1E1D"
                        android:textSize="22sp" />

                    <!-- Shows the current model name, set from code -->
                    <TextView
                        android:id="@+id/modelTitle"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#1F1E1D"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        app:backgroundTint="@null"
                        android:background="@drawable/voice"
                        android:id="@+id/micBtn"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:minWidth="44dp"
                        android:minHeight="44dp"
                        android:padding="0dp"
                        android:textSize="20sp" />
                    <!--android:text="🎤"-->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sendBtn"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        app:backgroundTint="@null"
                        android:background="@drawable/bg_send_circle"
                        android:minWidth="44dp"
                        android:minHeight="44dp"
                        android:padding="0dp"
                        android:text="↑"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Memory screen ===== -->
        <LinearLayout
            android:id="@+id/memoryLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:text="Memory"
                    android:textColor="#1F1E1D"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/memoryBackBtn"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Back" />
            </LinearLayout>

            <TextView
                android:id="@+id/memoryStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#73726C" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/useMemorySwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Use memory in answers"
                android:textColor="#1F1E1D" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/learnFactsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Learn facts from chat (slower)"
                android:textColor="#1F1E1D" />

            <ListView
                android:id="@+id/memoryListView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/addNoteBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Add note" />

                <Button
                    android:id="@+id/importDocBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Import doc" />

                <Button
                    android:id="@+id/clearAllBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Clear all" />
            </LinearLayout>

            <Button
                android:id="@+id/embedderBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Set up embedder files" />
        </LinearLayout>

        <!-- ===== Settings screen ===== -->
        <LinearLayout
            android:id="@+id/settingsLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:text="Settings"
                    android:textColor="#1F1E1D"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/settingsBackBtn"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Back" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Profile"
                        android:textColor="#73726C"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/settingsNameEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Your name"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLines="1"
                        android:textColor="#1F1E1D" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Assistant"
                        android:textColor="#73726C"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="System prompt"
                        android:textColor="#1F1E1D" />

                    <EditText
                        android:id="@+id/systemPromptEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minLines="3"
                        android:textColor="#1F1E1D" />

                    <Button
                        android:id="@+id/resetPromptBtn"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reset to default" />

                    <TextView
                        android:id="@+id/maxTokensLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="#1F1E1D" />

                    <SeekBar
                        android:id="@+id/maxTokensSeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="15" />

                    <TextView
                        android:id="@+id/tempLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="#1F1E1D" />

                    <SeekBar
                        android:id="@+id/tempSeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Models and memory"
                        android:textColor="#73726C"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/settingsModelBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Change model" />

                    <Button
                        android:id="@+id/settingsMemoryBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Open memory" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Voice"
                        android:textColor="#73726C"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Voice language (speaking and listening)"
                        android:textColor="#1F1E1D" />

                    <Spinner
                        android:id="@+id/voiceLangSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/offlineOnlySwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Offline voice only (on-device recognizer)"
                        android:textColor="#1F1E1D" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/autoSendSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Send voice messages automatically"
                        android:textColor="#1F1E1D" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Data"
                        android:textColor="#73726C"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/deleteAllChatsBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Delete all conversations" />

                    <TextView
                        android:id="@+id/aboutText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:textColor="#73726C"
                        android:textSize="12sp" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- ===== Loading overlay ===== -->
        <LinearLayout
            android:id="@+id/loadingLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC000000"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="16dp"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </FrameLayout>

    <!-- ================= NAVIGATION DRAWER ================= -->
    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#F5F4EE"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:padding="16dp"
            android:text="AI Chat"
            android:textColor="#1F1E1D"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/drawerNewChatBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="+  New chat" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp"
            android:text="Recents"
            android:textColor="#73726C"
            android:textSize="12sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/convList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp" />

            <TextView
                android:id="@+id/convEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="No conversations yet"
                android:textColor="#73726C" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33888888" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/userRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:id="@+id/avatarText"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/drawerUserName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#1F1E1D"
                    android:textSize="16sp" />
            </LinearLayout>

            <Button
                android:id="@+id/drawerSettingsBtn"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="0dp"
                android:text="⚙"
                android:textColor="#1F1E1D"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
