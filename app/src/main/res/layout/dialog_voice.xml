<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_voice_dialog"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="28dp"
    android:paddingTop="24dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/voiceText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Speak now"
        android:textColor="#5F6368"
        android:textSize="22sp" />

    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp">

        <!-- Pulsing lavender halo -->
        <View
            android:id="@+id/voiceHalo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_voice_halo" />

        <!-- Red mic circle -->
        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_voice_mic">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic_white" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
